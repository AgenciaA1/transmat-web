# Copia este archivo como .env.local y completa lo que necesites.
# Sin ninguna variable el sitio funciona: el planificador valida con Zod y
# honeypot, responde OK y registra la solicitud en el log; la analítica no envía nada.

# URL pública del despliegue. Alimenta canónicas, sitemap, llms.txt y OpenGraph.
# Sin ella se asume https://transmat.cl
NEXT_PUBLIC_SITE_URL=

# El sitio NO se indexa salvo que esto valga exactamente "true".
# Vacío en previsualización (workers.dev); "true" solo el día del lanzamiento en transmat.cl.
NEXT_PUBLIC_INDEXABLE=

# Contenedor de Google Tag Manager. El sitio actual usa GTM-KVKGS78S; decidir
# una sola vía de etiquetado antes de activarlo (auditoría H-020).
NEXT_PUBLIC_GTM_ID=

# Correo de las solicitudes del planificador y del contacto (Resend).
# Sin la key, la solicitud se valida y se registra, pero no se envía correo.
RESEND_API_KEY=
# Casillas internas que reciben cada solicitud, separadas por coma.
SOLICITUD_EMAIL_INTERNO=
# Remitente verificado en Resend, ej: "Transmat <solicitudes@transmat.cl>"
RESEND_FROM_EMAIL=
